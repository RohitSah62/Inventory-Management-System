# WARNING: Sample values below are for LOCAL DEVELOPMENT ONLY (with docker-compose.yml).
# Never commit your real .env file and NEVER reuse sample passwords or local defaults in production.
# In production, set strong unique credentials through your hosting provider's environment settings.

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Basic Auth credentials for Dashboard & API access (replace placeholder before using)
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-local-dev-only

# PostgreSQL (local docker-compose default; use managed DB URI + DATABASE_SSL=true in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_fifo
DATABASE_SSL=false

# Kafka (Local Redpanda/Kafka or Managed Redpanda Cloud / Confluent Cloud)
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=inventory-events
KAFKA_GROUP_ID=inventory-fifo-consumer
KAFKA_CLIENT_ID=inventory-fifo-service

# Optional SASL/SSL for Managed Kafka (Redpanda Cloud / Confluent Cloud / Upstash)
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
